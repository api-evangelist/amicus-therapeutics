{
  "title": "Amicus Medicine Structure",
  "description": "JSON structure documentation for an Amicus Therapeutics marketed medicine.",
  "fields": [
    { "name": "medicineId", "type": "string", "required": true, "description": "Stable identifier for the medicine record" },
    { "name": "brandName", "type": "string", "required": true, "description": "Registered brand name (e.g., Galafold)" },
    { "name": "genericName", "type": "string", "required": true, "description": "INN / nonproprietary name (e.g., migalastat)" },
    { "name": "drugClass", "type": "string", "required": false, "description": "Pharmacological Chaperone | Enzyme Replacement Therapy | Enzyme Stabilizer | Small Molecule | Biologic" },
    { "name": "routeOfAdministration", "type": "string", "required": false, "description": "Oral, intravenous, etc." },
    { "name": "indication", "type": "string", "required": true, "description": "Approved disease indication" },
    { "name": "patientPopulation", "type": "string", "required": false, "description": "Eligible patient subset" },
    { "name": "combinationWith", "type": "array[string]", "required": false, "description": "Other medicines required in the regimen" },
    { "name": "mechanismOfAction", "type": "string", "required": false, "description": "Brief MoA description" },
    { "name": "approvals", "type": "array[object]", "required": false, "description": "Per-region regulatory approvals (region, agency, approvalDate)" },
    { "name": "productSite", "type": "string", "required": false, "description": "Public patient information website" }
  ]
}
